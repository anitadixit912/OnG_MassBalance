# Copy this file to .env and fill in your values before running docker compose up

# ── AI Core (SAP Generative AI Hub) ─────────────────────────────────────────
# Set IBD_TESTING=0 to use real AI Core; IBD_TESTING=1 for mock responses (no AI Core needed)
IBD_TESTING=1

# Required when IBD_TESTING=0:
AICORE_DEPLOYMENT_ID=
AICORE_DESTINATION_NAME=aicore
AICORE_RESOURCE_GROUP=default

# ── OGS S/4HANA Destination (live data) ─────────────────────────────────────
# Set these when running outside BTP (Docker locally).
# Leave empty to rely on BTP Destination Service when deployed to Cloud Foundry.
OGS_S4_URL=
OGS_S4_TOKEN_URL=
OGS_S4_CLIENT_ID=
OGS_S4_CLIENT_SECRET=

# ── Agent URL ───────────────────────────────────────────────────────────────
# Used by the CAP app to reach the orchestrator (default: same container)
MASS_BALANCE_AGENT_URL=http://localhost:8080
