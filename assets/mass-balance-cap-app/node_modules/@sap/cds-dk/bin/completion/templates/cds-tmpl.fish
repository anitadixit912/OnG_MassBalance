#!/bin/fish
# This file was generated from bin/completion/templates/cds-tmpl.fish by
# 'cds completion --generate' and is written to bin/completion/scripts/cds.fish.
#
# Do not edit directly — modify the template and regenerate.
#
# Fish's completion model differs from bash/zsh: instead of one catch-all function,
# each subcommand and flag gets its own 'complete' line with a condition (-n).
# The static section covers all known commands, flags, and positionals up-front;
# _completeCdsDynamic handles the rest.
#
# Key fish completion flags used below:
#   -c <cmd>   : the command this completion applies to
#   -n <cond>  : only activate when the condition returns 0 (success)
#   -f         : do not complete with file names (required when -a provides the values)
#   -a         : argument values shown as completions

# Erase any previously-loaded completions for 'cds' so stale entries from older
# versions of this file do not accumulate across shell restarts.
complete -c cds -e

# Static completions: one 'complete' call per known command, flag, or positional.
# __fish_use_subcommand  — returns 0 (true) when no subcommand token has been typed yet.
# __fish_seen_subcommand_from <tokens> — returns 0 when any of <tokens> is on the line.
{{COMMAND_COMPLETIONS}}

# Helper for comma-separated option values (e.g. --add ai,ams,<tab>).
# Call with the full list of valid values as arguments:
#   _cdsCommaComplete val1 val2 val3
# Reads the current token, splits on commas, omits already-used values,
# and echoes remaining candidates prefixed with the already-typed portion.
function _cdsCommaComplete
    set -l all_values $argv
    set -l cur (commandline -ct)
    set -l parts (string split , $cur)
    set -l prefix (string join , $parts[1..-2])
    set -l partial $parts[-1]
    if test (count $parts) -gt 1
        set prefix $prefix","
    end
    for v in $all_values
        if contains $v $parts[1..-2]
            continue
        end
        if string match -q "$partial*" $v
            echo $prefix$v
        end
    end
end

# Dynamic fallback — called for subcommands whose arguments cannot be determined
# statically (e.g. service names, model names, unknown flags).
# File paths for commands like compile/deploy are handled by the static FILE() sentinel above.
# Single-quoting $previous/$current prevents bare word 'h' from being interpreted
# as the 'help' shortcut by the completion handler before it is processed.
function _completeCdsDynamic
    set -l tokens (commandline -opc)
    set -l current (commandline -ct)
    set -l previous $tokens[-1]
    set -l line (commandline -cp)
    cds completion --shell fish --prev "'$previous'" --curr "'$current'" --line "'$line'"
end
# Activate the dynamic fallback only after a known subcommand (or its shortcut) has been
# seen, so it does not shadow the static top-level command list.
complete -c cds -f -n '__fish_seen_subcommand_from {{CMD_LIST_WITH_SHORTCUTS}}' --arguments "(_completeCdsDynamic)"
