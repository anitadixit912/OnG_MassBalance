{
  {{#withTelemetry}}
  "dependencies": {
    "@cap-js/telemetry": "^2",
    "@grpc/grpc-js": "^1",
    "@opentelemetry/exporter-trace-otlp-grpc": ">=0.200",
    "@opentelemetry/exporter-metrics-otlp-grpc": ">=0.200",
    "@opentelemetry/instrumentation-host-metrics": ">=0.2"
  },
  {{/withTelemetry}}
  "cds": {
    "requires": {
      {{^withTelemetry}}
      "cloud-logging": true
      {{/withTelemetry}}
      {{#withTelemetry}}
      "[{{profile}}]": {
        "telemetry": {
          "kind": "to-cloud-logging"
        }
      }
      {{/withTelemetry}}
    }
  }
}
