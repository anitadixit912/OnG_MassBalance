modules:
  - name: {{appName}}-ams-policies-deployer
    build-parameters:
      buildpack:
        {{#hasKymaUnifiedRuntime}}
        builder: proxy-unified-runtime-dmz.int.repositories.cloud.sap/builder/noble
        {{/hasKymaUnifiedRuntime}}
        {{^hasKymaUnifiedRuntime}}
        type: nodejs
        builder: builder-jammy-full
        {{/hasKymaUnifiedRuntime}}
        {{#isJava}}
        path: srv/src/gen/policies
        {{/isJava}}
        {{^isJava}}
        path: gen/policies
        {{/isJava}}
        env:
          BP_NODE_RUN_SCRIPTS: ""
          BP_NODE_VERSION: "24"

