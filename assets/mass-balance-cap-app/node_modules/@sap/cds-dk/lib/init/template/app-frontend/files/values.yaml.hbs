---
content-agent-service:
  serviceOfferingName: content-agent
  servicePlanName: application
app-front:
  serviceOfferingName: app-front
  servicePlanName: developer
html5-apps-deployer:
  env:
    {{#hasIas}}
    IAS_DEPENDENCY_NAME: {{appName}}-ias-api
    {{/hasIas}}
    {{#hasIas}}destinations: {{#literal}}'[{"forwardAuthToken":true,"name":"srv-api","url":"https://{{ .Release.Name }}-srv-{{ .Release.Namespace }}.{{ .Values.global.domain }}","IASDependencyName":"{{/literal}}{{appName}}-ias-api{{#literal}}"}]'{{/literal}}{{/hasIas}}
    {{^hasIas}}destinations: {{#literal}}'[{"forwardAuthToken":true,"name":"srv-api","url":"https://{{ .Release.Name }}-srv-{{ .Release.Namespace }}.{{ .Values.global.domain }}"}]'{{/literal}}{{/hasIas}}
  image:
    repository: {{appName}}-html5-deployer
  bindings:
    content-agent-service:
      serviceInstanceName: content-agent-service
    app-front:
      serviceInstanceName: app-front
    {{#hasXsuaa}}
    xsuaa:
      serviceInstanceName: xsuaa
    {{/hasXsuaa}}
    {{#hasIas}}
    identity:
      serviceInstanceName: identity
      parameters:
        credential-type: X509_GENERATED
        app-identifier: html5-deployer
    {{/hasIas}}
