{
  {{#isNodejs}}
  "dependencies": {
    "@cap-js/hana": "^3"
  },
  "cds": {
    "requires": {
      "[production]": {
      {{#shortcut}}
        "db": "hana-serverless"
      {{/shortcut}}
      {{^shortcut}}
        "db": {
          "kind": "hana-serverless"
        }
      {{/shortcut}}
      }
    }
  }
  {{/isNodejs}}
  {{#isJava}}
  "requires": {
    "[production]": {
    {{#shortcut}}
      "db": "hana-serverless"
    {{/shortcut}}
    {{^shortcut}}
      "db": {
        "kind": "hana-serverless"
      }
    {{/shortcut}}
    }
  }
  {{/isJava}}
}
