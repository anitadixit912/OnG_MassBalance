---
modules:
  - name: {{appName}}-sidecar
    build-parameters:
      buildpack:
        {{#hasKymaUnifiedRuntime}}
        builder: proxy-unified-runtime-dmz.int.repositories.cloud.sap/builder/noble
        {{/hasKymaUnifiedRuntime}}
        {{^hasKymaUnifiedRuntime}}
        type: nodejs
        builder: builder-jammy-base
        {{/hasKymaUnifiedRuntime}}
        path: {{#isNodejs}}gen/{{/isNodejs}}mtx/sidecar{{#isJava}}/gen{{/isJava}}
        env:
          BP_NODE_RUN_SCRIPTS: ""
