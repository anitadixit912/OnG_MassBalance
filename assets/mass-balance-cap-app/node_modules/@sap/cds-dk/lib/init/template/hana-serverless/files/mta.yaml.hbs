---
modules:
  - name: {{appName}}-srv
    type: {{language}}
    path: {{& srv.path}}
    requires:
      - name: {{appName}}-db
      - name: {{appName}}-hana-auth
        parameters:
          config:
            credential-type: X509_GENERATED
            app-identifier: srv

  - name: {{appName}}-db-deployer
    type: hdb
    path: {{& db.path}}
    parameters:
      buildpack: nodejs_buildpack
{{#isJava}}
    build-parameters:
      builder: custom
      commands:
        - npm run build
{{/isJava}}
    requires:
      - name: {{appName}}-db
      - name: {{appName}}-hana-auth
        parameters:
          config:
            credential-type: X509_GENERATED
            app-identifier: db-deployer

  - name: {{appName}}-mtx
    type: nodejs
    path: {{#isNodejs}}gen/{{/isNodejs}}mtx/sidecar
    requires:
      - name: {{appName}}-db
      - name: {{appName}}-hana-auth
        parameters:
          config:
            credential-type: X509_GENERATED
            app-identifier: mtx

resources:
  - name: {{appName}}-db
    type: org.cloudfoundry.managed-service
    parameters:
      service: hana-cloud
      service-plan: serverless
      config:
        auto_subscription:
          type: subscription-manager
        subscribe_with_consuming_app: true

  - name: {{appName}}-hana-auth
    type: org.cloudfoundry.managed-service
    processed-after:
      - {{appName}}-db
    parameters:
      service: identity
      service-plan: application
      config:
        consumed-services:
          - service-instance-name: {{appName}}-db
