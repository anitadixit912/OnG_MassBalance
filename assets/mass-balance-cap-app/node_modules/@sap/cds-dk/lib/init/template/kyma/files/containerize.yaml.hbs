---
_schema-version: '1.0'
repository: {{& imageRegistry}}
tag: latest
{{#hasKymaUnifiedRuntime}}
{{#isJava}}
before-all:
  - helm dependency update ./gen/chart
  - mvn clean package -DskipTests=true --batch-mode
{{/isJava}}
{{/hasKymaUnifiedRuntime}}
{{^hasJava}}
{{#hasKymaUnifiedRuntime}}
before-all:
  - helm dependency update ./gen/chart
{{/hasKymaUnifiedRuntime}}
{{/hasJava}}
{{^hasKymaUnifiedRuntime}}
{{#hasJava}}
before-all:
  - mvn clean package -DskipTests=true --batch-mode
{{/hasJava}}
{{/hasKymaUnifiedRuntime}}
modules:
  - name: {{appName}}-srv
    build-parameters:
      buildpack:
        {{#hasKymaUnifiedRuntime}}
        builder: proxy-unified-runtime-dmz.int.repositories.cloud.sap/builder/noble
        {{/hasKymaUnifiedRuntime}}
        {{^hasKymaUnifiedRuntime}}
        {{#isNodejs}}
        type: nodejs
        {{/isNodejs}}
        builder: builder-jammy-base
        {{/hasKymaUnifiedRuntime}}
        path: {{#isNodejs}}gen/srv{{/isNodejs}}{{#isJava}}srv/target/{{appName}}-exec.jar{{/isJava}}
        env:
        {{#isNodejs}}
          BP_NODE_RUN_SCRIPTS: ""
        {{/isNodejs}}
        {{#isJava}}
          SPRING_PROFILES_ACTIVE: cloud
          BP_JVM_VERSION: 25
        {{/isJava}}
