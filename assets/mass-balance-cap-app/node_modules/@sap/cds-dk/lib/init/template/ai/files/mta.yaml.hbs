---
modules:
  - name: {{appName}}-srv
    type: {{language}}
    path: {{& srv.path}}
    requires:
      - name: {{appName}}-ai

resources:
  - name: {{appName}}-ai
    type: org.cloudfoundry.managed-service
    parameters:
      service: aicore
      service-plan: {{#servicePlan}}{{servicePlan}}{{/servicePlan}}{{^servicePlan}}standard{{/servicePlan}}
